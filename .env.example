# Neon / Vercel Postgres connection string
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Any long random string; signs the login cookie. `openssl rand -base64 32`
AUTH_SECRET="change-me-to-something-long-and-random"

# Free key from https://aistudio.google.com/apikey — powers "Ask the desk".
# Leave it blank and the app works fine, minus the AI panel.
GEMINI_API_KEY=""
# Optional override if the default model isn't on your tier.
GEMINI_MODEL="gemini-3.5-flash-lite"
